<mvc:View controllerName="com.sap.demobank.controller.App"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns:l="sap.ui.layout"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <App id="app">
        <Page id="page" title="{i18n>appTitle}">
            <headerContent>
                <Button id="refresh" type="Emphasized" text="{i18n>home}" />
            </headerContent>
            <content>
            <!-- Bank Details Fragment -->
                <core:Fragment id="frag1" fragmentName="com.sap.demobank.view.fragments.BankDetails" type="XML"/>
            </content>
        </Page>
    </App>
</mvc:View>
