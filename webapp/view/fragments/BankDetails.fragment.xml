<core:FragmentDefinition 
    xmlns:core = "sap.ui.core" 
    xmlns = "sap.m">

    <VBox id="vBox1" class="sapUiSmallMargin">
        <Title text="{i18n>accDetails}" id="accDetails" level="H1" />

        <HBox id="hBox1">
            <Label text="{i18n>accNum}" id="bankAccNum" class="sapUiSmallMarginEnd"/>
            <Text text="{i18n>accNumVal}" id="bankAccVal" class="sapuiSmallMarginBegin"/>
        </HBox>
        <HBox id="hBox2">
            <Label text="{i18n>accHolder}" id="accHolder" class="sapUiSmallMarginEnd"/>
            <Text text="{i18n>accHolderVal}" id="accHolderVal" />
        </HBox>
        <HBox id="hBox3">
            <Label text="{i18n>bankName}" id="bankName" class="sapUiSmallMarginEnd"/>
            <Text text="{i18n>bankNameVal}" id="bankNameVal"/>
        </HBox>
    </VBox>

</core:FragmentDefinition>